# PostgreSQL da aplicação. DATABASE_URL também é aceito.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=novamart
DB_USER=postgres
DB_PASS=change-me

# Gere uma chave aleatória para a sessão Flask:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Metabase: use a URL acessível pelo navegador do usuário.
METABASE_SITE_URL=http://localhost:3000
METABASE_DASHBOARD_ID=2
METABASE_SECRET_KEY=replace-with-current-metabase-embedding-secret

# Opcional. Por padrão, Flask escuta apenas localmente e sem debug.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
APP_ENV=development

# Opcional: notificações do orquestrador.
DISCORD_WEBHOOK_URL=
